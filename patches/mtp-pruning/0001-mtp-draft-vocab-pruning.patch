@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Draft-vocab pruning for MTP drafters (magpie-spark-vllm mtp-pruning).
+
+The draft keeps a K-row slice of the target ``lm_head`` (the ids in the
+keep-set) and its logits are scattered back to full-vocab positions, so the
+rest of the speculative pipeline is unchanged.
+"""
+
+import torch
+
+
+def load_keep_ids(path: str, vocab_size: int) -> torch.Tensor:
+    """Load the keep-set: a strictly ascending 1-D int64 tensor of target ids."""
+    keep = torch.load(path, map_location="cpu")
+    if (
+        keep.is_floating_point()
+        or keep.dtype == torch.bool
+        or keep.ndim != 1
+        or keep.numel() == 0
+    ):
+        raise ValueError(
+            f"draft_vocab_path {path}: expected a non-empty 1-D integer "
+            f"tensor, got {keep.dtype} with shape {tuple(keep.shape)}"
+        )
+    keep = keep.to(torch.int64)
+    if (
+        not bool((keep[1:] > keep[:-1]).all())
+        or int(keep[0]) < 0
+        or int(keep[-1]) >= vocab_size
+    ):
+        raise ValueError(
+            f"draft_vocab_path {path}: ids must be strictly ascending and "
+            f"within [0, {vocab_size})"
+        )
+    return keep
+
+
+def scatter_draft_logits(
+    logits: torch.Tensor, keep_ids: torch.Tensor, vocab_size: int
+) -> torch.Tensor:
+    """Place K-row draft logits at their target ids; -inf outside the keep-set."""
+    full = logits.new_full((logits.shape[0], vocab_size), float("-inf"))
+    full[:, keep_ids] = logits
+    return full
