+    def gather_rows(self, ngram_ids: torch.Tensor) -> torch.Tensor:
+        """Read the rows of ``ngram_ids`` from the mmapped checkpoint shards.
+
+        Unique ids are sorted, so each shard's rows form one contiguous run;
+        runs are split across threads so page faults overlap on the NVMe.
+        Returns ``[*ngram_ids.shape, head_dim]`` on the device of
+        ``ngram_ids``.
+        """
+        assert self.shards is not None
+        unique_ids, inverse = torch.unique(ngram_ids, return_inverse=True)
+        ids = unique_ids.cpu()
+        shard_ids = ids // self.shard_size
+        local_ids = ids - shard_ids * self.shard_size
+        rows = self.staging[: ids.numel()]
+        runs = torch.searchsorted(shard_ids, self.shard_starts).tolist()
+        chunk = max(1, math.ceil(ids.numel() / self.gather_threads))
+        tasks = [
+            (shard, start, min(start + chunk, end))
+            for shard, (begin, end) in enumerate(zip(runs, runs[1:]))
+            for start in range(begin, end, chunk)
+        ]
+
+        def gather(task: tuple[int, int, int]) -> None:
+            shard, start, end = task
+            torch.index_select(
+                self.shards[shard], 0, local_ids[start:end], out=rows[start:end]
+            )
+
+        for _ in self.gather_pool.map(gather, tasks):
+            pass
+        return rows.to(ngram_ids.device, non_blocking=True)[inverse]
