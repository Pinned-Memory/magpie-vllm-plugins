+def _madvise_random(tensor: torch.Tensor) -> None:
+    """Turn off readahead on the file pages behind an mmapped tensor.
+
+    Row gathers are random 4 KiB reads; the default readahead would pull
+    128 KiB per miss through the page cache.
+    """
+    start = tensor.data_ptr()
+    page_start = start - start % 4096
+    length = tensor.numel() * tensor.element_size() + (start - page_start)
+    madv_random = 1
+    ctypes.CDLL(None).madvise(
+        ctypes.c_void_p(page_start), ctypes.c_size_t(length), madv_random
+    )
